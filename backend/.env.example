# Uniyra AI Lab backend — local dev example. Copy to .env and fill in.
# Never commit real secrets.
MONGO_URL=mongodb://localhost:27017
DB_NAME=omnilab
JWT_SECRET=change-me-dev-secret-min-32-chars
# Generate a real Fernet key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-output-of-fernet-generate-key
FRONTEND_URL=http://localhost:3002

# --- auth / session / seed ---
# Admin seeding is OFF by default and has no built-in credentials. To create an
# admin on a fresh database, set ENABLE_ADMIN_SEED=true AND provide both
# ADMIN_EMAIL and ADMIN_PASSWORD. Existing users are never modified at startup.
ENABLE_ADMIN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# development | production. Production honours only CORS_ORIGINS / FRONTEND_URL.
OMNILAB_ENV=development
# Extra allowed browser origins, comma-separated (never "*" with credentials).
# Example for Tailscale/LAN dev: CORS_ORIGINS=http://100.95.85.93:3002,http://100.95.85.93:3003
# (development also auto-allows 100.x / RFC1918 LAN / *.ts.net via regex).
CORS_ORIGINS=
# Cookie policy. SameSite must be one of lax|strict|none; "none" forces Secure.
# Local plain-http dev (localhost or Tailscale/LAN over http) needs false so
# the browser stores the session cookie; use true only behind https.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .example.com
COOKIE_DOMAIN=

# --- provider URL safety (SSRF) ---
# Defaults are strict: only http/https public hosts. For local gateways
# (Ollama, LiteLLM, vLLM, ...) set PROVIDER_ALLOW_LOCAL_URLS=true. This never
# permits cloud metadata IPs. PROVIDER_URL_ALLOWLIST entries are host or
# host:port and explicitly bypass the checks (including metadata) on purpose.
PROVIDER_ALLOW_LOCAL_URLS=false
PROVIDER_URL_ALLOWLIST=
PROVIDER_URL_ALLOW_PRIVATE=false

# --- benchmark runner ---
# Bounded, resumable execution. Concurrency is clamped to BENCHMARK_MAX_CONCURRENCY.
# Plans above BENCHMARK_CONFIRM_THRESHOLD calls require explicit confirmation;
# BENCHMARK_MAX_PLANNED_CALLS is a hard cap.
BENCHMARK_CONCURRENCY=3
BENCHMARK_MAX_CONCURRENCY=10
BENCHMARK_CONFIRM_THRESHOLD=50
BENCHMARK_MAX_PLANNED_CALLS=2000
BENCHMARK_MAX_RETRIES=1

PORT=8001

# --- workspace platform (V4) ---
# Attachments / project files
ATTACHMENT_STORAGE_DIR=
MAX_ATTACHMENT_SIZE_MB=20
MAX_ATTACHMENTS_PER_MESSAGE=10
MAX_TOTAL_ATTACHMENT_SIZE_MB=50
PROJECT_FILE_MAX_BYTES=20971520
# Context / tool loop
MAX_TOOL_ROUNDS=5
RESERVED_OUTPUT_TOKENS=1024
# Forced finalization output budget (V4.2.3.13, server-side only; not user quota)
# Attempt-1 / recovery budgets let forced synthesis reserve room for the visible answer.
FINALIZATION_MAX_OUTPUT_TOKENS=8192
FINALIZATION_RECOVERY_MAX_OUTPUT_TOKENS=16384
FINALIZATION_PARTIAL_MIN_CHARS=400
# auto | full | evidence
FINALIZATION_EVIDENCE_VIEW_MODE=auto
FINALIZATION_EVIDENCE_VIEW_THRESHOLD_TOKENS=20000
FINALIZATION_EVIDENCE_VIEW_MAX_CHARS=24000
# low | medium | high (only applied when the model declares reasoning_effort)
FINALIZATION_REASONING_EFFORT=low
CONTEXT_ESTIMATOR=tiktoken
# Knowledge
KNOWLEDGE_DEFAULT_CHUNK_SIZE=800
KNOWLEDGE_DEFAULT_CHUNK_OVERLAP=100
KNOWLEDGE_MAX_CHUNK_CHARS=4000
KNOWLEDGE_MAX_CHUNKS_PER_COLLECTION=5000
KNOWLEDGE_MAX_DOCUMENTS_PER_COLLECTION=200
KNOWLEDGE_RETRIEVAL_TOP_K=5
# Embeddings: local (offline hashing) | openai_compatible (BYOK provider)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_DIM=256
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30
# Custom HTTP tools (redirects are unconditionally disabled today)
TOOL_HTTP_TIMEOUT_SECONDS=15
TOOL_HTTP_MAX_RESPONSE_BYTES=1048576
TOOL_HTTP_MAX_REDIRECTS=0
TOOL_HTTP_MAX_URL_LENGTH=2048
OPENAPI_MAX_SPEC_BYTES=2097152
# Fetch resilience timeout hierarchy (V4.2.3.7)
# Provider-level connection/streaming ceiling (adapter-owned)
PROVIDER_CONNECTION_TIMEOUT_SECONDS=120
# Server ceilings for a single URL fetch / search request (valves may lower, never raise)
FETCH_REQUEST_TIMEOUT_MAX_SECONDS=60
SEARCH_REQUEST_TIMEOUT_MAX_SECONDS=60
# Whole agentic tool-run wall-clock budget
AGENT_TOOL_BUDGET_SECONDS=180
# Model-call watchdog (V4.2.3.12, server-side only; no LLM-provider Valve schema)
MODEL_CONNECTION_TIMEOUT_SECONDS=60
MODEL_IDLE_TIMEOUT_SECONDS=120
MODEL_CALL_MAX_DURATION_SECONDS=600
# Code interpreter (Docker sandbox)
CODE_INTERPRETER_ENABLED=true
CODE_INTERPRETER_RUNTIME=docker
CODE_INTERPRETER_IMAGE=omnilab-code-interpreter:latest
CODE_INTERPRETER_TIMEOUT_SECONDS=30
CODE_INTERPRETER_MEMORY_MB=512
CODE_INTERPRETER_CPUS=1.0
CODE_INTERPRETER_PIDS_LIMIT=128
CODE_INTERPRETER_TMPFS_MB=64
CODE_INTERPRETER_MAX_OUTPUT_BYTES=204800
CODE_INTERPRETER_MAX_FILES=10
CODE_INTERPRETER_MAX_FILE_BYTES=5242880
CODE_INTERPRETER_MAX_EXECUTIONS_PER_RUN=5
CODE_INTERPRETER_MAX_CODE_CHARS=100000
