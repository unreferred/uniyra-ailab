# Uniyra AI Lab — Docker Compose installation configuration.
# Copy this file to `.env` in the repository root and edit before first start:
#   cp .env.example .env
#
# SECURITY: never commit .env. Generate fresh secrets for every installation.

# ---------------------------------------------------------------- required ---
# Generate with: openssl rand -hex 32  (use >= 32 random characters; the backend
# does not enforce a minimum length, a short secret makes session tokens guessable)
JWT_SECRET=

# Fernet key: exactly 32 random bytes, url-safe base64 (44 characters). Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
# The backend refuses to start on any other format. Losing this key makes stored
# provider/tool credentials undecryptable.
ENCRYPTION_KEY=

# ------------------------------------------------------------- entrypoint ---
# The single public HTTP port (frontend + reverse-proxied API).
# Changing it only needs `docker compose up -d` (the frontend calls /api on its
# own origin, so no rebuild is required).
APP_PORT=8080

# ------------------------------------------------------------ application ---
# MongoDB database name.
DB_NAME=omnilab

# Extra browser origins allowed by CORS/CSRF, comma-separated, no trailing
# slash. REQUIRED for any access other than http://localhost:<APP_PORT> (another
# machine, a hostname, or an https reverse proxy) - without it login succeeds but
# every write request fails with 403 "CSRF validation failed". Examples:
#   CORS_ORIGINS=http://192.168.1.50:8080,http://100.x.y.z:8080
# Plain http://localhost:<APP_PORT> is always allowed via FRONTEND_URL.
CORS_ORIGINS=

# Cookie flags. Keep COOKIE_SECURE=false for plain-http local use; set true
# only when the entrypoint is served over https.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ------------------------------------------------- optional admin seeding ---
# OFF by default: no account exists until you register one in the UI, or seed
# one here on a FRESH database. Both values are required to enable.
# Generate a strong password with: openssl rand -base64 18
ENABLE_ADMIN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -------------------------------------------------- optional feature flag ---
# Code-interpreter sandbox. Disabled by default in Docker and NOT functional with
# the stock images: it needs a docker CLI inside the backend plus access to the host
# Docker socket (root-equivalent on the host). See "Code interpreter" in
# docs/DOCKER_INSTALL.md before enabling. The rest of the app works without it.
CODE_INTERPRETER_ENABLED=false
